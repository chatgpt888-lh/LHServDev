							   cell.setHorizontalAlignment(Rectangle.ALIGN_RIGHT);
							   cell.setVerticalAlignment(Rectangle.ALIGN_MIDDLE);
							   cell.setBorderColor(borderColor);
							   cell.setFixedHeight(21);
