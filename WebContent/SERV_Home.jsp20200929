	team_condition = "";
	if (!user_group.equals("A")) {
		team_condition = " AND h.i_team = '"+user_group+"' ";
	}
	sql.delete(0,sql.length());
	sql.append("SELECT a.i_seq, a.i_chart_grp, a.f_approve, COUNT(DISTINCT h.i_docno) AS NUM_DOC")
		.append(" FROM lan:serv_infdochd h, lan:serv_infdocdt d, lan:serv_infdocap a, lan:serv_pstaff s")
		.append(" WHERE s.user_id = '")
		.append(userId)
		.append("' AND s.com_id = h.i_company AND s.proj_id = h.i_project")
		.append(" AND h.i_docno = a.i_docno AND h.i_docno = d.i_docno AND d.i_itmtype = '02' AND h.f_status != 'CAN' ")
		.append(team_condition)
		.append(inf_condition)
		.append(" GROUP BY a.i_seq, a.i_chart_grp, a.f_approve ORDER BY a.i_seq, a.i_chart_grp, a.f_approve");
