			sql.append(" select count(distinct c.i_docno) as cnt, c.f_itmstatus, b.f_reject, b.d_reject, c.d_payment ")
				  .append("  from lan:serv_infpayment c, lan:serv_infdochd b,lan:serv_pstaff a ")
