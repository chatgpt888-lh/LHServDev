		//cell.setVerticalAlignment(Rectangle.ALIGN_TOP);
		cell.setColspan(100);
		cell.setBorder(0);
		table.addCell(cell);
		
		
		cell = new PdfPCell(new Phrase(doString.MS874ToUnicode(headerReport), microssfont_HD));
		cell.setHorizontalAlignment(Rectangle.ALIGN_LEFT);
		cell.setVerticalAlignment(Rectangle.ALIGN_TOP);
		cell.setColspan(50);
