						cCONServiceStaffWait += count; // Service Staff Wait , current payment
					} else if (nextPaymentDate.equals(dPayment)) {
						nCONConstructorPass += count; // Constructor Pass , next payment
						nCONServiceStaffWait += count; // Service Staff Wait , next payment
					}
