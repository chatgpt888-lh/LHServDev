<table border="0" width="100%" cellspacing="0" cellpadding="0">
  <tr>
    <td width="100%" class="frmL">
    
      <table border="0" width="100%" cellspacing="0" cellpadding="0">
        <tr>
<% if (project.equals("LHALL")) { %>                
          <td class="col_name">โครงการ</td>
<%  } %>    
          <td class="col_name">วันที่นัด</td>
          <td class="col_name">เวลานัด</td>      
          <td class="col_name">บ้านเลขที่</td>
          <td class="col_name">แปลง</td>
          <td class="col_name">ชื่อลูกค้า</td>
          <td class="col_name">โทร</td>
          <td class="col_name">สถานะ</td>
          <td class="col_name">Ref_no</td>
          <td class="col_name">เลขที่ใบแจ้งซ่อม</td>
          <td class="col_name">ผู้บันทึกนัด</td>
        </tr>
<%		
	
		
		String condition = "", d_appoint_start = "", d_appoint_end = "", d_start = "", t_start = "", d_end = "", t_end = "", follow_status = "";
		String d_tracking = "";
		if (!project.equals("LHALL")) {
           condition = " and a.i_company = '"+i_company+"' and a.i_project = '"+i_project+"' ";
        }  
		if (lock.trim().length()>0) {
           condition += " and a.i_lock = '"+lock+"' ";
        }   
		if (house.trim().length()>0) {
           condition += " and b.i_house = '"+house+"' ";
        }
        
        
   
		
		
		sql.delete(0, sql.length());
		sql.append("select a.i_company, a.i_project, a.i_lock, b.i_house, a.d_appoint_start, a.d_appoint_end, a.n_customer, a.n_custel, a.i_refno, a.i_docno, a.i_emp_update ")
			.append("from lan:tele_dochd a, lan:acxlckmd b ")	
			.append("where a.i_company = b.i_company ")
			.append("and a.i_project = b.i_project ")
			.append("and a.i_lock = b.i_lock ")
			.append("and date(a.d_appoint_start) between '"+doString.displayNumber("0000", begYY)+"-"+doString.displayNumber("00", begMM)+"-"+doString.displayNumber("00", begDD)+"' ")  
			.append("and '"+doString.displayNumber("0000", endYY)+"-"+doString.displayNumber("00", endMM)+"-"+doString.displayNumber("00", endDD)+"' ")
			.append(condition)
			.append("order by a.i_company, a.i_project, a.d_appoint_start, a.i_lock ");	
			//out.println(sql.toString());
		rs = stmt.executeQuery(sql.toString());
		while (rs.next()) {
		
				d_appoint_start = doString.checkString(rs.getString("d_appoint_start"));
				d_appoint_end = doString.checkString(rs.getString("d_appoint_end"));
				if (d_appoint_start.trim().length() == 21){
						d_start = d_appoint_start.substring(8,10)+"/"+d_appoint_start.substring(5,7)+"/"+d_appoint_start.substring(2,4); 
						t_start =  d_appoint_start.substring(11,16);
				}
				if (d_appoint_end.trim().length() == 21){
						d_end = d_appoint_end.substring(8,10)+"/"+d_appoint_end.substring(5,7)+"/"+d_appoint_end.substring(2,4); 
						t_end =  d_appoint_end.substring(11,16);
				}
				
				
				 
				//out.println("date=="+d_appoint_start.trim().length());
				
		//2020-05-10 09:30:00.0
				follow_status = "";
				d_tracking = "";
				status_detail = "";
				sql.delete(0, sql.length());
				sql.append("select d_tracking, follow_status from lan:tele_tracking ")
				   .append("where i_refno = '"+doString.checkString(rs.getString("i_refno"))+"' ")
				   .append("order by d_tracking desc ");
				rs1 = stmt1.executeQuery(sql.toString());
				if (rs1.next()) {
						follow_status = doString.checkString(rs1.getString("follow_status"));					
				}
					if (follow_status.equals("900")) {
						status_detail = "Finish";
					} else {
						status_detail = "On Process";
					}
				
				
				sql.delete(0, sql.length());
				sql.append("select d_tracking from lan:tele_line_log ")
				   .append("where i_refno = '"+doString.checkString(rs.getString("i_refno"))+"' ")
				   .append("order by d_tracking desc ");
				rs1 = stmt1.executeQuery(sql.toString());
				if (rs1.next()) {						
						d_tracking = doString.checkString(rs1.getString("d_tracking"));
				}
				
				n_emp = "";
				sql.delete(0, sql.length());
				sql.append("select n_nemploy_th from docflow:acemploy ")
				   .append("where i_employ = '"+doString.checkString(rs.getString("i_emp_update"))+"' ");				
				rs1 = stmt1.executeQuery(sql.toString());
				if (rs1.next()) {
						n_emp = doString.MS874ToUnicode(doString.checkString(rs1.getString("n_nemploy_th")));					
				}
				
%>
        <tr>
<% if (project.equals("LHALL")) { %>          
          <td align="center" class="dotline"><%=doString.checkString(rs.getString("i_company"))%>-<%=doString.checkString(rs.getString("i_project"))%></td>
<%  } %>
          <td align="center" class="dotline"><%=d_start%>&nbsp;-&nbsp;<%=d_end%></td>
          <td align="center" class="dotline"><%=t_start%></td>
		  <td align="center" class="dotline ; item"><%=doString.checkString(rs.getString("i_house"))%></td>
          <td class="dotline" align="center"><a href="LINE_SERVList.jsp?i_company=<%=doString.checkString(rs.getString("i_company"))%>&i_project=<%=doString.checkString(rs.getString("i_project"))%>&i_lock=<%=doString.checkString(rs.getString("i_lock"))%>&i_house=<%=doString.checkString(rs.getString("i_house"))%>&i_refno=<%=doString.checkString(rs.getString("i_refno"))%>"><%=doString.checkString(rs.getString("i_lock"))%></a></td>
          <td class="dotline"><%=doString.MS874ToUnicode(doString.checkString(rs.getString("n_customer")))%></td>    
          <td align="left" class="dotline"><%=doString.checkString(rs.getString("n_custel"))%></td>   
          <td align="center" class="dotline"><%=status_detail%></td>
          <td class="dotline" align="center"><%=doString.checkString(rs.getString("i_refno"))%></td>    
          <td align="center" class="dotline"><%=doString.checkString(rs.getString("i_docno"))%></td>     
          <td align="center" class="dotline"><%=n_emp%></td>
        </tr>
<%
		} // end while
%>
      <!--  <tr>
          <td align="center" class="dotline">20/02/2563</td>
          <td align="center" class="dotline">11:00</td>
			<td align="center" class="dotline ; item"><a href="LINE_SERVList.jsp">299/672</a></td>
          <td class="dotline" align="center">01M10</td>
          <td class="dotline">นางใจดี สมหญิง</td>
          <td align="center" class="dotline">0814441115</td>
          <td align="center" class="dotline">เข้าซ่อม (200)</td>
