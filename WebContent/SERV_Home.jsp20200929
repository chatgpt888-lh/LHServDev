		if (user_group.equals("A") || user_group.equals("I")) {
			rs = stmt.executeQuery(sql.toString());
			while (rs.next()) {
				itemStatus = doString.checkString(rs.getString("f_itmstatus"),"");
				fReject = doString.checkString(rs.getString("f_reject"),"");
