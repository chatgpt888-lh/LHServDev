				else if (itemStatus.equalsIgnoreCase("600")) {
					if (currentPaymentDate.equals(dPayment)) {
						cCONServiceStaffPass += count; // Service Staff Pass , current payment
						cCONServiceManagerWait += count; // Service Managet Wait , current payment
					} else if (nextPaymentDate.equals(dPayment)) {
						nCONServiceStaffPass += count; // Service Staff Pass , next payment
						nCONServiceManagerWait += count; // Service Managet Wait , next payment
					}
				}
				else if (itemStatus.equalsIgnoreCase("700")) {
						if (currentPaymentDate.equals(dPayment)) {
