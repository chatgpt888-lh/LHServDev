							cCONManagerWait += count; // Manager Wait , current payment
						} else if (nextPaymentDate.equals(dPayment)) {
							nCONServiceManagerPass += count; // Service Manager Pass , next payment
							nCONManagerWait += count; // Manager Wait , next payment
						}
				}
	
				else if (itemStatus.equalsIgnoreCase("800")) {
						if (currentPaymentDate.equals(dPayment)) {
							cCONManagerPass += count; // Managet Pass , current payment
							cCONVPWait += count;  // VP Wait , current payment 
						} else if (nextPaymentDate.equals(dPayment)) {
							nCONManagerPass += count; // Managet Pass , next payment
							nCONVPWait += count;  // VP Wait , next payment 
